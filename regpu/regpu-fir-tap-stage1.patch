+// Frame IR capture tap (fir_tap.h): one draw's shaders, buffers, textures and record, while a capture runs.
+void FirTapAddBuffer(std::vector<firtap::BufferRef>& out, firtap::DataKind kind, uint32_t slot, uint32_t addr, uint32_t bytes, uint32_t endian,
+    const uint8_t* source)
+{
+    firtap::BufferRef b{};
+    b.kind = kind;
+    b.slot = slot;
+    b.guestAddr = addr;
+    b.bytes = std::min<uint32_t>(bytes, 64u << 20);
+    b.endian = endian;
+    if (source && b.bytes)
+    {
+        b.hash = firtap::HashBytes(source, b.bytes);
+        if (firtap::NeedData(kind, b.hash))
+            firtap::Data(kind, b.hash, source, b.bytes);
+    }
+    out.push_back(b);
+}
+
+// The vertex fetches of a shader, from its microcode (the translation's own layout is empty with baked vertex fetch,
+// the default): ReGPU's vfl packing (x constant | format << 8 | signed << 14 | normalized << 15 | round << 16,
+// y stride, z offset in dwords, w destination swizzle | exp << 16) plus the destination register in w bits 24-31.
+// A mini fetch reads through the full fetch before it (its constant and stride).
+std::vector<std::array<uint32_t, 4>> FirTapVertexFetches(const std::vector<uint32_t>& codeBE)
+{
+    std::vector<std::array<uint32_t, 4>> out;
+    const ucode::Shader shader = ucode::Parse(codeBE.data(), uint32_t(codeBE.size()), false);
+    uint32_t lastConst = 0, lastStride = 0;
+    bool lastRound = false;
+    for (const ucode::Cf& cf : shader.cf)
+    {
+        if (!cf.IsExec())
+            continue;
+        for (uint32_t k = 0; k < cf.count(); k++)
+        {
+            const uint32_t index = cf.address() + k;
+            if ((index + 1) * 3 > shader.words.size() || !((cf.sequence() >> (2 * k)) & 1))
+                continue;
+            const ucode::Fetch f = ucode::DecodeFetch(&shader.words[index * 3]);
+            if (f.opcode != 0)
+                continue;
+            if (!f.isMini)
+                lastConst = f.constIndex, lastStride = f.stride, lastRound = f.roundIndex;
+            out.push_back({ (f.isMini ? lastConst : f.constIndex) | (f.format << 8) | (f.isSigned ? 0x4000u : 0) | (f.isNormalized ? 0x8000u : 0) |
+                    (lastRound ? 0x10000u : 0),
+                lastStride, f.offset, (f.destSwizzle & 0xFFF) | ((uint32_t(f.expAdjust) & 0x3F) << 16) | ((f.dest & 0xFF) << 24) });
+        }
+    }
+    return out;
+}
+
+void FirTapDraw(uint32_t initiator, uint32_t dmaBase, uint32_t dmaSize, const CompiledShader& vs, const CompiledShader& ps)
+{
+    for (int pixel = 0; pixel < 2; pixel++)
+    {
+        const CompiledShader& s = pixel ? ps : vs;
+        const uint64_t hash = pixel ? C().psHash : C().vsHash;
+        if (!firtap::NeedShader(hash, pixel != 0))
+            continue;
+        const std::vector<uint32_t>& code = pixel ? C().psCode : C().vsCode;
+        const std::vector<std::array<uint32_t, 4>> fetches = pixel ? std::vector<std::array<uint32_t, 4>>() : FirTapVertexFetches(code);
+        firtap::Shader(hash, pixel != 0, code.data(), code.size(), s.info.usedTextureSlots, s.info.constantMask.data(), s.info.vertexFetchConstants.data(),
+            s.info.vertexFetchConstants.size(), reinterpret_cast<const uint32_t(*)[4]>(fetches.data()), fetches.size());
+    }
+    std::vector<firtap::BufferRef> buffers;
+    if (((initiator >> 6) & 3) == 0) // indices from an index buffer (DMA)
+    {
+        const bool is32 = (initiator >> 11) & 1;
+        const uint32_t addr = dmaBase & 0x1FFFFFFF & ~(is32 ? 3u : 1u);
+        FirTapAddBuffer(buffers, firtap::kDataIndex, 0, addr, (dmaSize & 0xFFFFFF) * (is32 ? 4u : 2u), dmaSize >> 30,
+            addr ? GuestPtr<uint8_t>(GpuPhysToGuest(addr)) : nullptr); // (as BuildIndexList reads them)
+    }
+    for (uint32_t k : vs.info.vertexFetchConstants)
+    {
+        const uint32_t d0 = gpureg::Get(gpureg::FetchConstants + k * 2), d1 = gpureg::Get(gpureg::FetchConstants + k * 2 + 1);
+        const uint32_t addr = d0 & 0xFFFFFFFC;
+        FirTapAddBuffer(buffers, firtap::kDataVertex, k, addr, ((d1 >> 2) & 0xFFFFFF) * 4, d1 & 3,
+            addr ? GuestPtr<uint8_t>(GpuPhysToGuest(addr)) : nullptr);
+    }
+    std::vector<firtap::TextureRef> textures;
+    const uint32_t slots = ps.info.usedTextureSlots | vs.info.usedTextureSlots;
+    for (uint32_t slot = 0; slot < 32; slot++)
+    {
+        if (!((slots >> slot) & 1))
+            continue;
+        const TextureFetch t = ReadTextureFetch(slot);
+        firtap::TextureRef r{};
+        r.slot = slot;
+        r.flags = ((ps.info.usedTextureSlots >> slot) & 1) ? 0u : firtap::kTexVertexShader;
+        memcpy(r.fetch, t.dwords, sizeof(r.fetch));
+        const size_t bytes = t.Type() == 2 && t.Address() ? std::min<size_t>(TextureSourceSize(t), 64u << 20) : 0;
+        if (ResolvedFor(t))
+            r.flags |= firtap::kTexResolved;
+        else if (!bytes)
+            r.flags |= firtap::kTexNoData;
+        else
+        {
+            const uint8_t* source = GuestPtr<uint8_t>(GpuPhysToGuest(t.Address()));
+            r.hash = firtap::HashBytes(source, bytes);
+            if (firtap::NeedData(firtap::kDataTextureRaw, r.hash))
+                firtap::Data(firtap::kDataTextureRaw, r.hash, source, bytes, t.Format(), t.Width(), t.Height());
+            bool decoded = !firtap::NeedData(firtap::kDataTextureRgba, r.hash);
+            if (!decoded && t.Dimension() == 1 && TextureFormatSupported(t.Format()))
+            {
+                std::vector<uint8_t> rgba;
+                if (DecodeTexture(t, rgba))
+                {
+                    firtap::Data(firtap::kDataTextureRgba, r.hash, rgba.data(), rgba.size(), t.Format(), t.Width(), t.Height());
+                    decoded = true;
+                }
+            }
+            if (decoded)
+                r.flags |= firtap::kTexDecoded;
+        }
+        textures.push_back(r);
+    }
+    uint32_t flags = 0;
+    if (!C().worker && g_occlusionOpen)
+        flags |= firtap::kDrawInOcclusionQuery;
+    if (vs.info.memExport)
+        flags |= firtap::kDrawMemExport;
+    if (WidePass())
+        flags |= firtap::kDrawWidePass;
+    if (C().worker)
+        flags |= firtap::kDrawOnWorker;
+    firtap::Draw(initiator, dmaBase, dmaSize, C().vsHash, C().psHash, flags, buffers.data(), buffers.size(), textures.data(), textures.size());
+}
