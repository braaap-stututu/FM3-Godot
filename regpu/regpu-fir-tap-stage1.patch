+// Frame IR capture tap: content hashes, from the full hash the index buffers use (fir_tap.h).
+fir_hash128 firtap::HashBytes(const void* data, size_t bytes)
+{
+    fir_hash128 h{};
+    h.lo = bytes ? FullHash(static_cast<const uint8_t*>(data), bytes) : 0;
+    h.hi = bytes;
+    return h;
+}
