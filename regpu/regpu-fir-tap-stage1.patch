diff --git a/src/gpu/fir_tap.cpp b/src/gpu/fir_tap.cpp
new file mode 100644
index 0000000..ef4c98d
--- /dev/null
+++ b/src/gpu/fir_tap.cpp
@@ -0,0 +1,305 @@
+// Frame IR capture tap, stage 1 (fir_tap.h).
+#include "gpu/fir_tap.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "gpu/regs.h"
+#include "live_switch.h"
+#include "log.h"
+
+// (firtap::HashBytes is defined in gpu/renderer.cpp, beside the hash it uses.)
+
+namespace firtap
+{
+bool g_on = false;
+
+namespace
+{
+// The registers tracked: the context registers and every constant (ALU, fetch, bool, loop).
+constexpr uint32_t kRanges[2][2] = { { 0x2000, 0x2400 }, { 0x4000, 0x4928 } };
+
+struct State
+{
+    bool init = false, enabled = false;
+    std::string path;
+    FILE* file = nullptr;
+    int64_t atFrame = -1;
+    uint32_t framesPerCapture = 3;
+    bool armedLast = false;
+    bool armed = false;     // a capture starts at the next frame
+    uint32_t framesLeft = 0; // frames still to capture (this one included)
+    bool inFrame = false;   // a FRAME_BEGIN was written for the current frame
+    uint64_t frame = 0;
+    uint32_t seq = 0;
+    uint64_t sequence = 0;  // packet number
+    uint64_t captures = 0;
+    std::vector<uint32_t> shadow[2];
+    std::set<std::pair<uint32_t, std::pair<uint64_t, uint64_t>>> data; // (kind, hash) written this capture
+    std::set<std::pair<uint64_t, uint32_t>> shaders;                  // (hash, pixel) written this capture
+    std::vector<uint8_t> records, blob;
+    uint32_t recordCount = 0;
+    uint64_t draws = 0, bytes = 0;
+};
+State g;
+std::mutex g_lock;
+
+void Configure()
+{
+    g.init = true;
+    const char* path = getenv("REGPU_FIR_CAPTURE");
+    g.enabled = path && *path;
+    if (!g.enabled)
+        return;
+    g.path = path;
+    if (const char* at = getenv("REGPU_FIR_AT"); at && *at)
+        g.atFrame = atoll(at);
+    if (const char* n = getenv("REGPU_FIR_FRAMES"); n && *n)
+        g.framesPerCapture = uint32_t(std::max(1, atoi(n)));
+    for (int r = 0; r < 2; r++)
+        g.shadow[r].assign(kRanges[r][1] - kRanges[r][0], 0);
+    Log("fir tap: available, writing to %s (%u frames a capture; arm with REGPU_FIR_ARM%s)", g.path.c_str(), g.framesPerCapture,
+        g.atFrame >= 0 ? " or at frame REGPU_FIR_AT" : "");
+}
+
+fir_blob_ref AddBlob(const void* data, size_t bytes)
+{
+    fir_blob_ref ref{};
+    if (!bytes)
+        return ref;
+    while (g.blob.size() % 16)
+        g.blob.push_back(0);
+    ref.offset = g.blob.size();
+    ref.size = bytes;
+    const auto* p = static_cast<const uint8_t*>(data);
+    g.blob.insert(g.blob.end(), p, p + bytes);
+    return ref;
+}
+
+template <typename T> void AddRecord(T& rec, uint16_t type)
+{
+    rec.h.type = type;
+    rec.h.flags = 0;
+    rec.h.size = uint32_t(sizeof(T));
+    const auto* p = reinterpret_cast<const uint8_t*>(&rec);
+    g.records.insert(g.records.end(), p, p + sizeof(T));
+    g.recordCount++;
+}
+
+void WritePacket()
+{
+    if (!g.file)
+    {
+        g.file = fopen(g.path.c_str(), "wb");
+        if (!g.file)
+        {
+            Log("fir tap: cannot open %s: capture dropped", g.path.c_str());
+            g.records.clear();
+            g.blob.clear();
+            g.recordCount = 0;
+            return;
+        }
+    }
+    fir_packet_header ph{};
+    ph.magic = FIR_MAGIC;
+    ph.version_major = FIR_VERSION_MAJOR;
+    ph.version_minor = FIR_VERSION_MINOR;
+    ph.sequence = g.sequence++;
+    ph.direction = FIR_DIR_FORWARD;
+    ph.record_count = g.recordCount;
+    ph.record_bytes = g.records.size();
+    ph.blob_bytes = g.blob.size();
+    fwrite(&ph, sizeof(ph), 1, g.file);
+    fwrite(g.records.data(), 1, g.records.size(), g.file);
+    fwrite(g.blob.data(), 1, g.blob.size(), g.file);
+    fflush(g.file);
+    g.bytes += sizeof(ph) + g.records.size() + g.blob.size();
+    g.records.clear();
+    g.blob.clear();
+    g.recordCount = 0;
+}
+
+// The tracked registers that changed since the last call (all of them with full), as pairs in the blob.
+fir_blob_ref RegisterDelta(bool full, uint32_t& count)
+{
+    std::vector<uint32_t> pairs;
+    for (int r = 0; r < 2; r++)
+        for (uint32_t i = kRanges[r][0]; i < kRanges[r][1]; i++)
+        {
+            const uint32_t v = gpureg::Get(i);
+            uint32_t& s = g.shadow[r][i - kRanges[r][0]];
+            if (full || v != s)
+            {
+                pairs.push_back(i);
+                pairs.push_back(v);
+                s = v;
+            }
+        }
+    count = uint32_t(pairs.size() / 2);
+    return AddBlob(pairs.data(), pairs.size() * 4);
+}
+
+// The first event of a captured frame: FRAME_BEGIN and the full register snapshot.
+void BeginFrameIfNeeded()
+{
+    if (g.inFrame)
+        return;
+    g.inFrame = true;
+    g.seq = 0;
+    if (g.sequence == 0)
+    {
+        fir_session_begin s{};
+        s.platform = FIR_PLATFORM_XBOX360;
+        s.host_kind = FIR_HOST_STATIC_RECOMP;
+        s.frontend_version = 1;
+        snprintf(s.frontend_name, sizeof(s.frontend_name), "ReGPU fir_tap stage 1");
+        AddRecord(s, FIR_REC_SESSION_BEGIN);
+    }
+    fir_frame_begin fb{};
+    fb.frame_index = g.frame;
+    fb.tick_index = g.frame;
+    AddRecord(fb, FIR_REC_FRAME_BEGIN);
+    XenosRegs regs{};
+    regs.full = 1;
+    regs.pairs = RegisterDelta(true, regs.count);
+    AddRecord(regs, kRecXenosRegs);
+}
+} // namespace
+
+void Tick(uint64_t frame)
+{
+    std::lock_guard lock(g_lock);
+    if (!g.init)
+        Configure();
+    if (!g.enabled)
+        return;
+    if (g_on)
+    {
+        // The frame just captured ends (a frame without draws or resolves wrote nothing and still counts).
+        if (g.inFrame)
+        {
+            fir_frame_end fe{};
+            fe.frame_index = g.frame;
+            fe.draw_count = g.seq;
+            AddRecord(fe, FIR_REC_FRAME_END);
+            WritePacket();
+            g.inFrame = false;
+        }
+        if (g.framesLeft && --g.framesLeft == 0)
+        {
+            g_on = false;
+            Log("fir tap: capture %llu done: %u frames, %llu draws, %.1f MB in %s", (unsigned long long)g.captures, g.framesPerCapture,
+                (unsigned long long)g.draws, double(g.bytes) / 1048576.0, g.path.c_str());
+        }
+    }
+    // Arming: the live switch going on, or the frame number.
+    static LiveSwitch arm("REGPU_FIR_ARM");
+    const bool armedNow = arm;
+    if ((armedNow && !g.armedLast) || (g.atFrame >= 0 && int64_t(frame) + 1 == g.atFrame))
+        g.armed = true;
+    g.armedLast = armedNow;
+    if (g.armed && !g.framesLeft)
+    {
+        g.armed = false;
+        g.framesLeft = g.framesPerCapture;
+        g.data.clear();
+        g.shaders.clear();
+        g.draws = 0;
+        g.captures++;
+        Log("fir tap: capture %llu starts at frame %llu", (unsigned long long)g.captures, (unsigned long long)(frame + 1));
+    }
+    g.frame = frame + 1;
+    g_on = g.framesLeft != 0;
+}
+
+bool NeedData(DataKind kind, const fir_hash128& hash)
+{
+    std::lock_guard lock(g_lock);
+    return g.data.find({ uint32_t(kind), { hash.lo, hash.hi } }) == g.data.end();
+}
+
+void Data(DataKind kind, const fir_hash128& hash, const void* data, size_t bytes, uint32_t format, uint32_t width, uint32_t height)
+{
+    std::lock_guard lock(g_lock);
+    if (!g_on || !g.data.insert({ uint32_t(kind), { hash.lo, hash.hi } }).second)
+        return;
+    BeginFrameIfNeeded();
+    XenosData d{};
+    d.kind = kind;
+    d.format = format;
+    d.width = width;
+    d.height = height;
+    d.hash = hash;
+    d.data = AddBlob(data, bytes);
+    AddRecord(d, kRecXenosData);
+}
+
+bool NeedShader(uint64_t hash, bool pixel)
+{
+    std::lock_guard lock(g_lock);
+    return g.shaders.find({ hash, pixel ? 1u : 0u }) == g.shaders.end();
+}
+
+void Shader(uint64_t hash, bool pixel, const uint32_t* code, size_t dwords, uint32_t textureSlots, const uint64_t constantMask[4],
+    const uint32_t* fetchConsts, size_t fetchConstCount, const uint32_t (*layouts)[4], size_t layoutCount)
+{
+    std::lock_guard lock(g_lock);
+    if (!g_on || !g.shaders.insert({ hash, pixel ? 1u : 0u }).second)
+        return;
+    BeginFrameIfNeeded();
+    XenosShader s{};
+    s.hash = hash;
+    s.pixel = pixel ? 1 : 0;
+    s.textureSlots = textureSlots;
+    memcpy(s.constantMask, constantMask, sizeof(s.constantMask));
+    s.fetchConstCount = uint32_t(fetchConstCount);
+    s.layoutCount = uint32_t(layoutCount);
+    s.code = AddBlob(code, dwords * 4);
+    s.fetchConsts = AddBlob(fetchConsts, fetchConstCount * 4);
+    s.layouts = AddBlob(layouts, layoutCount * 16);
+    AddRecord(s, kRecXenosShader);
+}
+
+void Draw(uint32_t initiator, uint32_t dmaBase, uint32_t dmaSize, uint64_t vsHash, uint64_t psHash, uint32_t flags, const BufferRef* buffers,
+    size_t bufferCount, const TextureRef* textures, size_t textureCount)
+{
+    std::lock_guard lock(g_lock);
+    if (!g_on)
+        return;
+    BeginFrameIfNeeded();
+    XenosDraw d{};
+    d.seq = g.seq++;
+    d.initiator = initiator;
+    d.dmaBase = dmaBase;
+    d.dmaSize = dmaSize;
+    d.vsHash = vsHash;
+    d.psHash = psHash;
+    d.flags = flags;
+    d.regs = RegisterDelta(false, d.regCount);
+    d.buffers = AddBlob(buffers, bufferCount * sizeof(BufferRef));
+    d.textures = AddBlob(textures, textureCount * sizeof(TextureRef));
+    d.bufferCount = uint32_t(bufferCount);
+    d.textureCount = uint32_t(textureCount);
+    AddRecord(d, kRecXenosDraw);
+    g.draws++;
+}
+
+void Resolve()
+{
+    std::lock_guard lock(g_lock);
+    if (!g_on)
+        return;
+    BeginFrameIfNeeded();
+    XenosResolve r{};
+    r.seq = g.seq++;
+    r.regs = RegisterDelta(false, r.regCount);
+    AddRecord(r, kRecXenosResolve);
+}
+} // namespace firtap
diff --git a/src/gpu/fir_tap.h b/src/gpu/fir_tap.h
new file mode 100644
index 0000000..63555d6
--- /dev/null
+++ b/src/gpu/fir_tap.h
@@ -0,0 +1,154 @@
+// Frame IR capture tap, stage 1 (Xenos-native). Writes the game's frames to a .fir capture file in the Frame IR
+// framing (frame_ir.h: packets, records, blobs) with Xenos-native private records, for the renderer-replacement
+// project's offline tools (its SPEC.md; stage 2, the canonical conversion, happens offline).
+//
+//   REGPU_FIR_CAPTURE=<file>  (start-time) the tap is available; nothing is captured until armed
+//   REGPU_FIR_ARM             (live switch) off -> on starts a capture at the next frame
+//   REGPU_FIR_AT=<frame>      (start-time) or start at that frame number
+//   REGPU_FIR_FRAMES=<n>      (start-time) frames per capture, default 3
+//
+// Captured: per frame a full register snapshot (context registers 0x2000-0x23FF, ALU/fetch/bool/loop constants
+// 0x4000-0x4927), then per draw and resolve the registers changed since the last one; per draw its initiator, index
+// buffer, shader hashes and the index, vertex and texture data it reads (each distinct content once per capture:
+// native bytes, plus RGBA8 for 2D textures ReGPU can decode); each shader once (microcode, fetch layout, constant
+// masks). The triple-screen and VR replays are skipped (they are ReGPU's, not the game's). Off: one bool test a draw.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+#include "gpu/frame_ir.h"
+
+namespace firtap
+{
+// Private record types (frame_ir.h: 0xF000-0xFFFF are platform-specific).
+enum : uint16_t
+{
+    kRecXenosRegs = 0xF101,
+    kRecXenosDraw = 0xF102,
+    kRecXenosResolve = 0xF103,
+    kRecXenosShader = 0xF104,
+    kRecXenosData = 0xF105,
+};
+
+enum DataKind : uint32_t
+{
+    kDataIndex = 0,       // native index bytes (endian as the draw's buffer ref says)
+    kDataVertex = 1,      // native vertex buffer bytes
+    kDataTextureRaw = 2,  // native texture bytes (base level as laid out in guest memory)
+    kDataTextureRgba = 3, // ReGPU's CPU decode of the same texture: RGBA8, width x height
+};
+
+// Register values changed since the previous event (or all of them: the frame's first record), as u32 pairs.
+struct XenosRegs
+{
+    fir_record_header h;
+    uint32_t count;
+    uint32_t full;
+    fir_blob_ref pairs; // { u32 register index, u32 value }[count]
+};
+
+struct BufferRef
+{
+    uint32_t kind; // kDataIndex / kDataVertex
+    uint32_t slot; // vertex fetch constant (vertex buffers); 0 for indices
+    uint32_t guestAddr; // GPU physical address
+    uint32_t bytes;
+    uint32_t endian; // Xenos endian mode (fetch constant / index buffer)
+    uint32_t _pad0;
+    fir_hash128 hash; // { FullHash(bytes), bytes }
+};
+
+enum : uint32_t
+{
+    kTexVertexShader = 1u << 0, // fetched by the vertex shader
+    kTexResolved = 1u << 1,     // a resolved render target (no data: it is this frame's output)
+    kTexDecoded = 1u << 2,      // an RGBA8 decode was written (kDataTextureRgba, same hash)
+    kTexNoData = 1u << 3,       // not a plain 2D/3D/cube texture or no size: fetch constant only
+};
+
+struct TextureRef
+{
+    uint32_t slot;
+    uint32_t flags;
+    uint32_t fetch[6]; // the texture fetch constant
+    fir_hash128 hash;  // of the raw bytes, 0 without data
+};
+
+enum : uint32_t
+{
+    kDrawInOcclusionQuery = 1u << 0,
+    kDrawMemExport = 1u << 1,
+    kDrawWidePass = 1u << 2, // ReGPU's main-view pass test (RB_SURFACE_INFO pitch of the main view)
+    kDrawOnWorker = 1u << 3, // recorded on a draw worker: order within the frame not guaranteed
+};
+
+struct XenosDraw
+{
+    fir_record_header h;
+    uint32_t seq;       // event number within the frame (draws and resolves)
+    uint32_t initiator; // VGT_DRAW_INITIATOR: primitive (bits 0-5), index source, 32-bit indices, index count (>> 16)
+    uint32_t dmaBase;   // index buffer address and size word as the packet gave them
+    uint32_t dmaSize;
+    uint64_t vsHash, psHash;
+    uint32_t flags;
+    uint32_t regCount;
+    fir_blob_ref regs;     // the register delta before this draw (pairs)
+    fir_blob_ref buffers;  // BufferRef[bufferCount]: the index buffer first (if indexed), then vertex buffers
+    fir_blob_ref textures; // TextureRef[textureCount]
+    uint32_t bufferCount;
+    uint32_t textureCount;
+};
+
+struct XenosResolve
+{
+    fir_record_header h;
+    uint32_t seq;
+    uint32_t regCount;
+    fir_blob_ref regs; // the register delta before it (RB_COPY_* and the rest)
+};
+
+struct XenosShader
+{
+    fir_record_header h;
+    uint64_t hash;
+    uint32_t pixel;
+    uint32_t textureSlots;    // bit per fetch slot
+    uint64_t constantMask[4]; // float constants read
+    uint32_t fetchConstCount;
+    uint32_t layoutCount;
+    fir_blob_ref code;        // microcode dwords
+    fir_blob_ref fetchConsts; // u32[fetchConstCount]: vertex fetch constants (vertex shaders)
+    fir_blob_ref layouts;     // u32[4][layoutCount]: ReGPU's vertex fetch layout per fetch (hlsl.cpp: vfl)
+};
+
+struct XenosData
+{
+    fir_record_header h;
+    uint32_t kind; // DataKind
+    uint32_t format; // texture format (raw / rgba: the guest format), 0 for buffers
+    uint32_t width, height;
+    fir_hash128 hash;
+    fir_blob_ref data;
+};
+
+static_assert(sizeof(XenosRegs) == 32 && sizeof(BufferRef) == 40 && sizeof(TextureRef) == 48 && sizeof(XenosDraw) == 104 &&
+                  sizeof(XenosResolve) == 32 && sizeof(XenosShader) == 112 && sizeof(XenosData) == 56,
+    "fir_tap record layout");
+
+extern bool g_on; // capturing the current frame
+inline bool On() { return g_on; }
+
+// At each swap (the renderer's frame end): ends a captured frame, arms or stops capturing.
+void Tick(uint64_t frame);
+
+// The renderer's events while On(). Data first, then the event that uses it.
+fir_hash128 HashBytes(const void* data, size_t bytes);
+bool NeedData(DataKind kind, const fir_hash128& hash);
+void Data(DataKind kind, const fir_hash128& hash, const void* data, size_t bytes, uint32_t format = 0, uint32_t width = 0, uint32_t height = 0);
+bool NeedShader(uint64_t hash, bool pixel);
+void Shader(uint64_t hash, bool pixel, const uint32_t* code, size_t dwords, uint32_t textureSlots, const uint64_t constantMask[4],
+    const uint32_t* fetchConsts, size_t fetchConstCount, const uint32_t (*layouts)[4], size_t layoutCount);
+void Draw(uint32_t initiator, uint32_t dmaBase, uint32_t dmaSize, uint64_t vsHash, uint64_t psHash, uint32_t flags, const BufferRef* buffers,
+    size_t bufferCount, const TextureRef* textures, size_t textureCount);
+void Resolve();
+} // namespace firtap
diff --git a/src/gpu/frame_ir.h b/src/gpu/frame_ir.h
new file mode 100644
index 0000000..8e7f9f2
--- /dev/null
+++ b/src/gpu/frame_ir.h
@@ -0,0 +1,808 @@
+/*
+ * frame_ir.h ??? Frame IR v0.2 draft binary layout.
+ *
+ * Meaning of every record and field: see SPEC.md (it wins on any disagreement).
+ *
+ * Layout rules (enforced by the static asserts at the bottom):
+ *   - little-endian, plain data, no pointers
+ *   - every record size is a multiple of 8
+ *   - every 64-bit field sits at an 8-byte offset; all padding is explicit (_pad*)
+ * so the same bytes are valid in a 32-bit game process, a 64-bit core process and
+ * a capture file. Compile with MSVC /we4820 (or -Wpadded -Werror) to keep it so.
+ *
+ * Valid as C11 and C++11.
+ */
+#ifndef FRAME_IR_H
+#define FRAME_IR_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#define FIR_STATIC_ASSERT(c, m) static_assert(c, m)
+#else
+#define FIR_STATIC_ASSERT(c, m) _Static_assert(c, m)
+#endif
+
+#define FIR_VERSION_MAJOR 0
+#define FIR_VERSION_MINOR 2
+#define FIR_MAGIC 0x31524946u /* "FIR1" */
+
+/* ------------------------------------------------------------------------- */
+/* Basic types                                                               */
+/* ------------------------------------------------------------------------- */
+
+typedef uint32_t fir_handle;       /* per-session; 0 = none */
+typedef uint64_t fir_instance_key; /* stable object identity; 0 = none */
+
+typedef struct fir_hash128 { uint64_t lo, hi; } fir_hash128; /* XXH3-128 */
+
+typedef struct fir_blob_ref {
+    uint64_t offset; /* from start of the packet's blob area, 16-byte aligned */
+    uint64_t size;   /* 0 = absent */
+} fir_blob_ref;
+
+typedef struct fir_vec4 { float x, y, z, w; } fir_vec4;
+
+/* Column-vector math, row-major storage. mat3x4 = top three rows of an affine 4x4. */
+typedef struct fir_mat3x4 { float m[3][4]; } fir_mat3x4;
+typedef struct fir_mat4   { float m[4][4]; } fir_mat4;
+
+/* ------------------------------------------------------------------------- */
+/* Enums (stored in the integer width of the field that uses them)           */
+/* ------------------------------------------------------------------------- */
+
+enum fir_direction { FIR_DIR_FORWARD = 0, FIR_DIR_REVERSE = 1 };
+
+enum fir_platform {
+    FIR_PLATFORM_UNKNOWN = 0,
+    FIR_PLATFORM_PC_D3D,      /* D3D3..9; version in frontend_name/flags */
+    FIR_PLATFORM_PC_OPENGL,
+    FIR_PLATFORM_PC_GLIDE,
+    FIR_PLATFORM_PS1,
+    FIR_PLATFORM_PS2,
+    FIR_PLATFORM_PS3,
+    FIR_PLATFORM_XBOX,
+    FIR_PLATFORM_XBOX360,
+    FIR_PLATFORM_N64,
+    FIR_PLATFORM_GAMECUBE,
+    FIR_PLATFORM_WII,
+    FIR_PLATFORM_WIIU,
+    FIR_PLATFORM_DREAMCAST,
+    FIR_PLATFORM_SATURN,
+    FIR_PLATFORM_PSP,
+    FIR_PLATFORM_3DS,
+    FIR_PLATFORM_VITA
+};
+
+enum fir_host_kind {
+    FIR_HOST_UNKNOWN = 0,
+    FIR_HOST_STATIC_RECOMP,
+    FIR_HOST_EMULATOR,
+    FIR_HOST_PC_PROXY,
+    FIR_HOST_SOURCE_PORT
+};
+
+enum fir_axis { FIR_AXIS_UNKNOWN = 0, FIR_AXIS_POS_X, FIR_AXIS_NEG_X, FIR_AXIS_POS_Y,
+                FIR_AXIS_NEG_Y, FIR_AXIS_POS_Z, FIR_AXIS_NEG_Z };
+enum fir_handedness { FIR_HANDED_UNKNOWN = 0, FIR_HANDED_RIGHT, FIR_HANDED_LEFT };
+
+enum fir_record_type {
+    /* forward 0x0000-0x7FFF */
+    FIR_REC_SESSION_BEGIN     = 0x0001,
+    FIR_REC_SESSION_END       = 0x0002,
+    FIR_REC_FRAME_BEGIN       = 0x0010,
+    FIR_REC_FRAME_END         = 0x0011,
+
+    FIR_REC_TEXTURE_CREATE    = 0x0100,
+    FIR_REC_TEXTURE_DATA      = 0x0101,
+    FIR_REC_TEXTURE_CONTENT   = 0x0102,
+    FIR_REC_GEOMETRY          = 0x0110,
+    FIR_REC_SHADER            = 0x0120,
+    FIR_REC_RESOURCE_DESTROY  = 0x01F0,
+
+    FIR_REC_TARGET            = 0x0200,
+    FIR_REC_PASS_BEGIN        = 0x0201,
+    FIR_REC_PASS_END          = 0x0202,
+    FIR_REC_COPY              = 0x0203,
+
+    FIR_REC_VIEW              = 0x0300,
+    FIR_REC_STATE             = 0x0400,
+    FIR_REC_DEFORM            = 0x0410,
+    FIR_REC_DRAW              = 0x0500,
+
+    FIR_REC_CAMERA            = 0x0600,
+    FIR_REC_OBJECT            = 0x0601,
+    FIR_REC_ENVIRONMENT       = 0x0602,
+    FIR_REC_LIGHT             = 0x0603,
+    FIR_REC_EVENT             = 0x0604,
+    FIR_REC_ANNOTATE          = 0x0605,
+
+    FIR_REC_JOB               = 0x0700,
+    FIR_REC_COMPOSITE_SURFACE = 0x0800,
+
+    /* reverse 0x8000-0xEFFF */
+    FIR_REC_CLAIM_RULES       = 0x8000,
+    FIR_REC_CONTENT_KNOWN     = 0x8001,
+    FIR_REC_CAPTURE_CONTROL   = 0x8002,
+    FIR_REC_PRESENT_FEEDBACK  = 0x8003,
+
+    /* private 0xF000-0xFFFF: platform/game specific, never required */
+    FIR_REC_PRIVATE_FIRST     = 0xF000
+};
+
+/* fir_record_header.flags */
+enum { FIR_REC_FLAG_REQUIRED = 1u << 0 }; /* reader must reject the stream if it does not know this type */
+
+enum fir_resource_kind { FIR_RES_TEXTURE = 1, FIR_RES_GEOMETRY, FIR_RES_TARGET, FIR_RES_STATE,
+                         FIR_RES_VIEW, FIR_RES_DEFORM };
+
+enum fir_texture_dim { FIR_TEX_2D = 0, FIR_TEX_3D, FIR_TEX_CUBE, FIR_TEX_2D_ARRAY };
+
+/* Canonical formats. Frontends decode everything else (palettes, swizzle/tiling,
+ * platform compression that is not BCn) into one of these. */
+enum fir_format {
+    FIR_FMT_UNKNOWN = 0,
+    FIR_FMT_R8_UNORM, FIR_FMT_RG8_UNORM, FIR_FMT_RGBA8_UNORM, FIR_FMT_RGBA8_SRGB,
+    FIR_FMT_BGRA8_UNORM, FIR_FMT_BGRA8_SRGB, FIR_FMT_RGB10A2_UNORM,
+    FIR_FMT_R16F, FIR_FMT_RG16F, FIR_FMT_RGBA16F, FIR_FMT_R32F, FIR_FMT_RGBA32F,
+    FIR_FMT_BC1, FIR_FMT_BC1_SRGB, FIR_FMT_BC2, FIR_FMT_BC2_SRGB, FIR_FMT_BC3, FIR_FMT_BC3_SRGB,
+    FIR_FMT_BC4, FIR_FMT_BC5, FIR_FMT_BC7, FIR_FMT_BC7_SRGB,
+    FIR_FMT_D16, FIR_FMT_D24S8, FIR_FMT_D32F, FIR_FMT_D32F_S8
+};
+
+/* fir_texture_create.flags */
+enum {
+    FIR_TEX_VOLATILE      = 1u << 0, /* changes often (RT, video, procedural): never persisted */
+    FIR_TEX_RENDER_TARGET = 1u << 1,
+    FIR_TEX_PALETTIZED    = 1u << 2  /* base_id differs from content_id */
+};
+
+/* fir_texture_content.flags / fir_geometry.flags */
+enum { FIR_CONTENT_DATA_OMITTED = 1u << 0 }; /* core acknowledged this content_id earlier */
+
+enum fir_topology { FIR_TOPO_POINTS = 0, FIR_TOPO_LINES, FIR_TOPO_LINE_STRIP,
+                    FIR_TOPO_TRIANGLES, FIR_TOPO_TRIANGLE_STRIP }; /* quads/fans/rects: convert */
+
+/* fir_geometry.flags (bit 0 is FIR_CONTENT_DATA_OMITTED) */
+enum {
+    FIR_GEOM_VOLATILE       = 1u << 1, /* CPU-generated per frame; not an asset identity */
+    FIR_GEOM_PRIMITIVE_RESTART = 1u << 2 /* index 0xFFFF / 0xFFFFFFFF restarts strips */
+};
+
+enum fir_semantic { FIR_SEM_POSITION = 0, FIR_SEM_NORMAL, FIR_SEM_TANGENT, FIR_SEM_BINORMAL,
+                    FIR_SEM_COLOR, FIR_SEM_TEXCOORD, FIR_SEM_BLENDINDICES, FIR_SEM_BLENDWEIGHT,
+                    FIR_SEM_POINTSIZE, FIR_SEM_CUSTOM };
+
+enum fir_attr_format {
+    FIR_AF_F32x1 = 0, FIR_AF_F32x2, FIR_AF_F32x3, FIR_AF_F32x4,
+    FIR_AF_F16x2, FIR_AF_F16x4,
+    FIR_AF_UNORM8x4, FIR_AF_SNORM8x4, FIR_AF_UINT8x4,
+    FIR_AF_UNORM16x2, FIR_AF_UNORM16x4, FIR_AF_SNORM16x2, FIR_AF_SNORM16x4,
+    FIR_AF_UINT16x2, FIR_AF_UINT16x4,
+    FIR_AF_UNORM10_10_10_2
+};
+
+enum fir_blend_factor { FIR_BF_ZERO = 0, FIR_BF_ONE, FIR_BF_SRC_COLOR, FIR_BF_INV_SRC_COLOR,
+                        FIR_BF_SRC_ALPHA, FIR_BF_INV_SRC_ALPHA, FIR_BF_DST_COLOR,
+                        FIR_BF_INV_DST_COLOR, FIR_BF_DST_ALPHA, FIR_BF_INV_DST_ALPHA,
+                        FIR_BF_CONSTANT, FIR_BF_INV_CONSTANT, FIR_BF_SRC_ALPHA_SAT };
+enum fir_blend_op { FIR_BO_ADD = 0, FIR_BO_SUBTRACT, FIR_BO_REV_SUBTRACT, FIR_BO_MIN, FIR_BO_MAX };
+enum fir_compare { FIR_CMP_NEVER = 0, FIR_CMP_LESS, FIR_CMP_EQUAL, FIR_CMP_LEQUAL,
+                   FIR_CMP_GREATER, FIR_CMP_NOTEQUAL, FIR_CMP_GEQUAL, FIR_CMP_ALWAYS };
+enum fir_cull { FIR_CULL_NONE = 0, FIR_CULL_FRONT, FIR_CULL_BACK };
+enum fir_filter { FIR_FILTER_POINT = 0, FIR_FILTER_LINEAR, FIR_FILTER_NONE /* mip: no mips */ };
+enum fir_address { FIR_ADDR_WRAP = 0, FIR_ADDR_MIRROR, FIR_ADDR_CLAMP, FIR_ADDR_BORDER,
+                   FIR_ADDR_MIRROR_ONCE };
+enum fir_fog_mode { FIR_FOG_NONE = 0, FIR_FOG_LINEAR, FIR_FOG_EXP, FIR_FOG_EXP2, FIR_FOG_OTHER };
+
+enum fir_space { FIR_SPACE_OBJECT = 0, FIR_SPACE_WORLD, FIR_SPACE_VIEW, FIR_SPACE_CLIP,
+                 FIR_SPACE_SCREEN };
+
+enum fir_category {
+    FIR_CAT_UNKNOWN = 0, FIR_CAT_WORLD_STATIC, FIR_CAT_WORLD_DYNAMIC, FIR_CAT_CHARACTER,
+    FIR_CAT_VEHICLE, FIR_CAT_SKY, FIR_CAT_WATER, FIR_CAT_FOLIAGE, FIR_CAT_PARTICLE,
+    FIR_CAT_DECAL, FIR_CAT_SHADOW, FIR_CAT_REFLECTION, FIR_CAT_POST, FIR_CAT_HUD,
+    FIR_CAT_UI_MENU, FIR_CAT_VIDEO
+};
+
+/* fir_draw.flags */
+enum {
+    FIR_DRAW_HAS_MODEL     = 1u << 0, /* model is valid */
+    FIR_DRAW_COMBINED_ONLY = 1u << 1, /* only `combined` (object->clip) is known */
+    FIR_DRAW_ESTIMATED     = 1u << 2, /* transforms were estimated, not observed */
+    FIR_DRAW_SUPPRESSED    = 1u << 3  /* v0.2: a claim rule stopped the original renderer drawing this */
+};
+
+enum fir_target_usage { FIR_TU_UNKNOWN = 0, FIR_TU_BACKBUFFER, FIR_TU_OFFSCREEN_COLOR,
+                        FIR_TU_DEPTH, FIR_TU_SHADOW, FIR_TU_REFLECTION, FIR_TU_ENV_CUBE,
+                        FIR_TU_POST };
+
+/* fir_pass_begin.clear_flags */
+enum { FIR_CLEAR_COLOR = 1u << 0, FIR_CLEAR_DEPTH = 1u << 1, FIR_CLEAR_STENCIL = 1u << 2 };
+
+enum fir_copy_kind { FIR_COPY_COPY = 0, FIR_COPY_RESOLVE, FIR_COPY_SCALE, FIR_COPY_FORMAT_CONVERT };
+
+/* fir_view.flags */
+enum {
+    FIR_VIEW_HAS_VIEW   = 1u << 0,
+    FIR_VIEW_HAS_PROJ   = 1u << 1,
+    FIR_VIEW_ORTHO      = 1u << 2,
+    FIR_VIEW_REVERSED_Z = 1u << 3,
+    FIR_VIEW_ESTIMATED  = 1u << 4
+};
+enum fir_source { FIR_SRC_OBSERVED = 0, FIR_SRC_FIXED_FUNCTION, FIR_SRC_HOOK,
+                  FIR_SRC_SHADER_CONSTANT, FIR_SRC_ESTIMATED };
+
+enum fir_deform_kind { FIR_DEFORM_SKIN_LINEAR = 0, FIR_DEFORM_SKIN_DUAL_QUAT, FIR_DEFORM_MORPH,
+                       FIR_DEFORM_PARAMS /* opaque, profile-implemented (schema) */ };
+
+enum fir_camera_role { FIR_CAM_MAIN = 0, FIR_CAM_MIRROR, FIR_CAM_REAR, FIR_CAM_CUTSCENE,
+                       FIR_CAM_OTHER };
+enum { FIR_CAMERA_CUT = 1u << 0 };
+
+enum fir_object_kind { FIR_OBJ_UNKNOWN = 0, FIR_OBJ_VEHICLE, FIR_OBJ_CHARACTER, FIR_OBJ_PROP,
+                       FIR_OBJ_WORLD_SECTION, FIR_OBJ_PROJECTILE };
+enum { FIR_OBJECT_VISIBLE = 1u << 0, FIR_OBJECT_TELEPORTED = 1u << 1 };
+
+enum fir_weather { FIR_WEATHER_UNKNOWN = 0, FIR_WEATHER_CLEAR, FIR_WEATHER_CLOUDY,
+                   FIR_WEATHER_RAIN, FIR_WEATHER_SNOW, FIR_WEATHER_FOG };
+
+enum fir_light_type { FIR_LIGHT_DIRECTIONAL = 0, FIR_LIGHT_POINT, FIR_LIGHT_SPOT,
+                      FIR_LIGHT_AMBIENT };
+enum { FIR_LIGHT_SHADOW_HINT = 1u << 0 };
+
+enum fir_annotate_op { FIR_ANN_PUSH = 0, FIR_ANN_POP, FIR_ANN_MARK };
+
+enum fir_job_unit { FIR_UNIT_OTHER = 0, FIR_UNIT_SPU, FIR_UNIT_VU0, FIR_UNIT_VU1,
+                    FIR_UNIT_GTE, FIR_UNIT_SH4, FIR_UNIT_DSP };
+enum fir_job_disposition { FIR_JOB_RAN = 0, FIR_JOB_SKIPPED_REPLACED, FIR_JOB_SKIPPED_IGNORED };
+enum fir_job_class { FIR_JOBCLASS_UNKNOWN = 0, FIR_JOBCLASS_RENDER_ONLY, FIR_JOBCLASS_GAMEPLAY,
+                     FIR_JOBCLASS_MIXED };
+
+enum fir_composite_layer { FIR_LAYER_HUD_OVERLAY = 0, FIR_LAYER_UNCLAIMED_WORLD,
+                           FIR_LAYER_FULL_FRAME };
+
+enum fir_claim_match { FIR_MATCH_CATEGORY = 0, FIR_MATCH_STATE_HASH, FIR_MATCH_GEOMETRY_ID,
+                       FIR_MATCH_TEXTURE_ID, FIR_MATCH_TARGET_USAGE, FIR_MATCH_JOB_TYPE };
+enum fir_claim_action { FIR_ACT_SUPPRESS_ORIGINAL = 0, FIR_ACT_KEEP_ORIGINAL, FIR_ACT_SKIP_JOB };
+enum { FIR_CLAIMS_REPLACE_ALL = 1u << 0 };
+
+/* fir_capture_control.mode */
+enum {
+    FIR_CAPTURE_FULL_DATA       = 1u << 0, /* never omit blobs */
+    FIR_CAPTURE_DISABLE_CULLING = 1u << 1, /* ask profile hooks to draw everything */
+    FIR_CAPTURE_DUMP_TO_FILE    = 1u << 2
+};
+
+/* ------------------------------------------------------------------------- */
+/* Framing                                                                   */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_packet_header {
+    uint32_t magic;          /* FIR_MAGIC */
+    uint16_t version_major;
+    uint16_t version_minor;
+    uint64_t sequence;       /* per direction, increments by 1 */
+    uint32_t direction;      /* fir_direction */
+    uint32_t record_count;
+    uint64_t record_bytes;
+    uint64_t blob_bytes;
+} fir_packet_header;
+
+typedef struct fir_record_header {
+    uint16_t type;   /* fir_record_type */
+    uint16_t flags;  /* FIR_REC_FLAG_* */
+    uint32_t size;   /* whole record incl. header, multiple of 8 */
+} fir_record_header;
+
+/* ------------------------------------------------------------------------- */
+/* Session / frame                                                           */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_session_begin {
+    fir_record_header h;
+    uint16_t platform;           /* fir_platform */
+    uint16_t host_kind;          /* fir_host_kind */
+    uint32_t frontend_version;
+    char     frontend_name[32];
+    char     title_id[32];       /* platform title id, or exe name for PC */
+    char     profile_id[32];
+    fir_hash128 executable_hash;
+    uint32_t native_width;
+    uint32_t native_height;
+    float    nominal_tick_hz;    /* 0 = unknown */
+    float    world_units_per_meter; /* 0 = unknown */
+    uint8_t  world_handedness;   /* fir_handedness */
+    uint8_t  world_up_axis;      /* fir_axis */
+    uint16_t flags;
+    uint32_t _pad0;
+} fir_session_begin;
+
+typedef struct fir_session_end {
+    fir_record_header h;
+    uint32_t reason; /* 0 = normal exit */
+    uint32_t _pad0;
+} fir_session_end;
+
+enum { FIR_FRAME_LOADING = 1u << 0, FIR_FRAME_PAUSED = 1u << 1, FIR_FRAME_SCENE_CUT = 1u << 2 };
+
+typedef struct fir_frame_begin {
+    fir_record_header h;
+    uint64_t frame_index;
+    uint64_t tick_index;
+    double   sim_time;
+    uint32_t original_present_interval; /* in original vblanks; 0 = unknown */
+    uint32_t flags;                     /* FIR_FRAME_* */
+    uint64_t claim_generation;          /* v0.2: CLAIM_RULES generation applied this frame; 0 = none */
+} fir_frame_begin;
+
+typedef struct fir_frame_end {
+    fir_record_header h;
+    uint64_t frame_index;
+    uint32_t draw_count;
+    uint32_t flags;
+} fir_frame_end;
+
+/* ------------------------------------------------------------------------- */
+/* Resources                                                                 */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_texture_create {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t flags;            /* FIR_TEX_* */
+    uint16_t dimension;        /* fir_texture_dim */
+    uint32_t width, height, depth;
+    uint16_t mip_count;
+    uint16_t array_layers;
+    uint16_t canonical_format; /* fir_format of TEXTURE_DATA blobs */
+    uint16_t _pad0;
+    uint32_t native_format;    /* platform enum value, for tooling and hashing */
+} fir_texture_create;
+
+typedef struct fir_texture_data {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t mip;
+    uint16_t layer;
+    uint32_t x, y, z;
+    uint32_t width, height, depth;
+    uint32_t row_pitch;        /* bytes per row (or per block row for BCn) in `data` */
+    uint32_t _pad0;
+    fir_blob_ref data;         /* canonical, decoded */
+    fir_hash128 native_hash;   /* of the native bytes of this region */
+} fir_texture_data;
+
+typedef struct fir_texture_content {
+    fir_record_header h;
+    fir_handle handle;
+    uint32_t flags;            /* FIR_CONTENT_* */
+    fir_hash128 content_id;
+    fir_hash128 base_id;       /* == content_id unless palettized */
+} fir_texture_content;
+
+typedef struct fir_vertex_attr {
+    uint8_t  semantic;         /* fir_semantic */
+    uint8_t  semantic_index;
+    uint8_t  format;           /* fir_attr_format */
+    uint8_t  _pad0;
+    uint16_t offset;           /* within vertex_stride */
+    uint16_t _pad1;
+} fir_vertex_attr;
+
+#define FIR_MAX_VERTEX_ATTRS 16
+
+typedef struct fir_geometry {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t flags;            /* FIR_CONTENT_DATA_OMITTED | FIR_GEOM_* */
+    uint8_t  topology;         /* fir_topology */
+    uint8_t  index_size;       /* 0 (non-indexed), 2 or 4 */
+    uint32_t vertex_count;
+    uint32_t index_count;
+    uint16_t vertex_stride;    /* single interleaved stream */
+    uint16_t attr_count;
+    uint32_t _pad0;
+    fir_blob_ref vertices;
+    fir_blob_ref indices;
+    fir_hash128 geometry_id;   /* positions + indices + topology (native) */
+    fir_hash128 content_id;    /* all attributes + indices + layout + topology (native) */
+    fir_vertex_attr attrs[FIR_MAX_VERTEX_ATTRS];
+} fir_geometry;
+
+enum fir_shader_stage { FIR_STAGE_VERTEX = 0, FIR_STAGE_PIXEL, FIR_STAGE_COMBINER, FIR_STAGE_OTHER };
+
+typedef struct fir_shader {
+    fir_record_header h;
+    fir_hash128 id;
+    uint16_t stage;            /* fir_shader_stage */
+    uint16_t native_kind;      /* platform-specific encoding id */
+    uint32_t _pad0;
+    fir_blob_ref native_code;
+} fir_shader;
+
+typedef struct fir_resource_destroy {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t kind;             /* fir_resource_kind */
+    uint16_t _pad0;
+} fir_resource_destroy;
+
+/* ------------------------------------------------------------------------- */
+/* Targets and passes                                                        */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_target {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t usage;            /* fir_target_usage (frontend's guess) */
+    uint16_t canonical_format; /* fir_format */
+    uint32_t width, height;
+    uint32_t samples;
+    uint32_t flags;
+} fir_target;
+
+#define FIR_MAX_COLOR_TARGETS 4
+
+typedef struct fir_pass_begin {
+    fir_record_header h;
+    fir_handle color[FIR_MAX_COLOR_TARGETS];
+    fir_handle depth;
+    uint32_t clear_flags;      /* FIR_CLEAR_* */
+    float    clear_color[4];
+    float    clear_depth;
+    uint32_t clear_stencil;
+} fir_pass_begin;
+
+typedef struct fir_pass_end {
+    fir_record_header h;
+    uint32_t draw_count;
+    uint32_t _pad0;
+} fir_pass_end;
+
+typedef struct fir_copy {
+    fir_record_header h;
+    fir_handle src;            /* target or texture */
+    fir_handle dst;
+    uint16_t kind;             /* fir_copy_kind */
+    uint16_t _pad0;
+    int32_t  src_rect[4];      /* x, y, w, h */
+    int32_t  dst_rect[4];
+    uint32_t _pad1;
+} fir_copy;
+
+/* ------------------------------------------------------------------------- */
+/* Drawing                                                                   */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_view {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t flags;            /* FIR_VIEW_* */
+    uint16_t source;           /* fir_source */
+    fir_mat3x4 view;           /* world -> view */
+    fir_mat4   proj;           /* view -> clip (canonical NDC) */
+    float    viewport[4];      /* x, y, w, h in target pixels */
+    float    depth_range[2];
+    int32_t  scissor[4];       /* x, y, w, h; w == 0 means none */
+} fir_view;
+
+typedef struct fir_sampler {
+    uint8_t  min_filter, mag_filter, mip_filter; /* fir_filter */
+    uint8_t  max_anisotropy;
+    uint8_t  address_u, address_v, address_w;    /* fir_address */
+    uint8_t  _pad0;
+    float    lod_bias;
+    uint32_t border_rgba8;
+} fir_sampler;
+
+typedef struct fir_texture_binding {
+    fir_handle texture;
+    uint8_t  slot;
+    uint8_t  _pad0[3];
+    fir_sampler sampler;
+} fir_texture_binding;
+
+#define FIR_MAX_TEXTURE_BINDINGS 8
+
+typedef struct fir_state {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t texture_count;
+    uint16_t flags;
+    fir_hash128 state_hash;    /* classifier key: native state + program ids */
+    fir_hash128 vertex_program;
+    fir_hash128 pixel_program; /* shader / combiner / TEV / GS blend config */
+    /* normalized fixed state */
+    uint8_t  blend_enable;
+    uint8_t  color_src, color_dst, color_op;  /* fir_blend_factor / fir_blend_op */
+    uint8_t  alpha_src, alpha_dst, alpha_op;
+    uint8_t  color_write_mask;                /* bit0 R .. bit3 A */
+    uint8_t  depth_test, depth_write;
+    uint8_t  depth_func;                      /* fir_compare */
+    uint8_t  cull_mode;                       /* fir_cull */
+    uint8_t  alpha_test_func;                 /* fir_compare; ALWAYS = off */
+    uint8_t  fog_mode;                        /* fir_fog_mode */
+    uint8_t  _pad0[2];
+    float    alpha_ref;
+    float    depth_bias;
+    float    slope_depth_bias;
+    uint32_t fog_rgba8;
+    float    fog_start, fog_end, fog_density;
+    uint32_t _pad1;
+    fir_blob_ref constants;    /* material-level program constants, native layout */
+    fir_blob_ref native_state; /* full native state block, tooling only */
+    fir_texture_binding textures[FIR_MAX_TEXTURE_BINDINGS];
+} fir_state;
+
+typedef struct fir_deform {
+    fir_record_header h;
+    fir_handle handle;
+    uint16_t kind;             /* fir_deform_kind */
+    uint16_t flags;
+    fir_hash128 schema;        /* for FIR_DEFORM_PARAMS: profile schema / job type */
+    uint32_t bone_count;
+    uint32_t morph_count;
+    fir_blob_ref bones;        /* fir_mat3x4[bone_count], object space */
+    fir_blob_ref morph_weights;/* float[morph_count] */
+    fir_blob_ref params;
+} fir_deform;
+
+typedef struct fir_draw {
+    fir_record_header h;
+    uint32_t seq;              /* order within frame */
+    fir_handle geometry;
+    fir_handle state;
+    fir_handle view;
+    fir_handle deform;         /* 0 = none */
+    uint16_t flags;            /* FIR_DRAW_* */
+    uint8_t  space;            /* fir_space */
+    uint8_t  category_hint;    /* fir_category (frontend/profile guess) */
+    uint32_t first_index;
+    uint32_t index_count;      /* 0 = whole geometry */
+    int32_t  base_vertex;
+    uint32_t instance_count;   /* 0 or 1 = not instanced */
+    fir_instance_key instance_key;
+    fir_mat3x4 model;          /* object -> world, if FIR_DRAW_HAS_MODEL */
+    fir_mat4   combined;       /* object -> clip, if FIR_DRAW_COMBINED_ONLY */
+    fir_blob_ref per_draw_constants;
+    fir_blob_ref instance_transforms; /* fir_mat3x4[instance_count] */
+} fir_draw;
+
+/* ------------------------------------------------------------------------- */
+/* Semantics (profile hooks / fixed-function state)                          */
+/* ------------------------------------------------------------------------- */
+
+typedef struct fir_camera {
+    fir_record_header h;
+    uint16_t role;             /* fir_camera_role */
+    uint16_t index;
+    uint32_t flags;            /* FIR_CAMERA_* */
+    double   sample_time;
+    fir_mat3x4 camera_to_world;
+    float    fov_y;            /* radians; 0 = unknown */
+    float    aspect;
+    float    near_z, far_z;
+} fir_camera;
+
+typedef struct fir_object {
+    fir_record_header h;
+    fir_instance_key key;
+    fir_instance_key parent;
+    double   sample_time;
+    uint16_t kind;             /* fir_object_kind */
+    uint16_t flags;            /* FIR_OBJECT_* */
+    uint32_t _pad0;
+    fir_mat3x4 local_to_world;
+    fir_vec4 linear_velocity;  /* world units / s */
+    fir_vec4 angular_velocity; /* rad / s, world axes */
+    fir_hash128 schema;
+    fir_blob_ref params;
+} fir_object;
+
+typedef struct fir_environment {
+    fir_record_header h;
+    fir_hash128 level_id;
+    char     level_name[64];
+    float    time_of_day_hours; /* < 0 = unknown */
+    uint16_t weather;          /* fir_weather */
+    uint16_t flags;
+    float    weather_intensity;
+    uint32_t _pad0;
+    fir_vec4 sun_direction;    /* world, pointing toward the sun */
+    fir_vec4 sun_color;        /* linear rgb, w = intensity */
+    fir_vec4 ambient_color;
+    fir_vec4 fog_color;        /* w = density */
